{
  "name": "code-dashboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": { "code-dash": "./dist/index.js" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:web": "cd web && npm install && npm run build",
    "build": "tsc -p . && npm run build:web",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "yargs": "^17.7.2",
    "toml": "^3.0.0",
    "yaml": "^2.5.1",
    "simple-git": "^3.27.0",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.5.0",
    "@types/yargs": "^17.0.33"
  }
}
